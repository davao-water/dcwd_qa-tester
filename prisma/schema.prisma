generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum Severity {
  S1
  S2
  S3
  S4
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// One counted attempt (a failed sign-in, a sign-up). Kept in the database because serverless functions share no
/// memory. Rows older than a day are removed by the daily clean-up.
model RateLimitHit {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now())

  @@index([key, at])
  @@index([at])
}

// ── QA Hub: accounts and the who's-who directory (Phase 3.5a) ──

enum UserRole {
  ADMIN
  QA
  DEV
}

/// Device notifications outside someone's work hours and days: as usual, without sound, or not at all (the bell only).
enum OffHoursPush {
  SOUND
  SILENT
  NONE
}

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique // stored lower-case
  passwordHash       String
  role               UserRole
  /// Can send UI/UX designs for approval (Design reviews), on top of their role.
  designer           Boolean            @default(false)
  /// Can manage Team & modules (modules, sub-modules and their members), on top of their role. Users stays admin-only.
  teamLead           Boolean            @default(false)
  active             Boolean            @default(true)
  /// Signed up on the sign-in page and waiting for an admin. Pending accounts are also inactive, so they can't sign in.
  pending            Boolean            @default(false)
  mustChangePassword Boolean            @default(true)
  /// Set when they asked for a new password on the sign-in page; cleared when an admin resets or dismisses it.
  resetRequestedAt   DateTime?
  /// SHA-256 of the secret the sign-up's browser keeps in a cookie. After approval only that browser can get the
  /// temporary password. Cleared once they choose their own password.
  claimHash          String?            @unique
  /// When that browser last got a temporary password, for the once-a-minute limit.
  claimAt            DateTime?
  /// What device notifications do outside workStartMin–workEndMin (minutes after midnight, Asia/Manila) on workDays.
  offHoursPush       OffHoursPush       @default(SOUND)
  workStartMin       Int                @default(420)
  workEndMin         Int                @default(1080)
  /// Bitmask of weekdays, bit 0 = Sunday … bit 6 = Saturday. 62 = Monday to Friday.
  workDays           Int                @default(62)
  /// The sound an open QA Hub tab plays for a device notification: "tone-1"…"tone-11" or "silent".
  notifyTone         String             @default("tone-1")
  /// Device notifications show the ticket title and the message. Off: only "#12 · New reply from Ana".
  pushPreviews       Boolean            @default(true)
  /// Picks their colours when they have no photo (lib/avatar.ts). Each account gets the next number.
  avatarColor        Int                @default(autoincrement())
  /// Their profile photo in Storage, generated like any upload's name. Empty: their colours show.
  avatarName         String?
  avatarMime         String?
  avatarSize         Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  sessions           Session[]
  areas              AreaMember[]
  reported           Ticket[]           @relation("TicketReporter")
  assigned           Ticket[]           @relation("TicketAssignee")
  comments           TicketComment[]
  ticketEvents       TicketEvent[]
  attachments        Attachment[]
  pendingUploads     PendingUpload[]
  darProfile         DarProfile?
  darReports         DarReport[]
  lastActed          Ticket[]           @relation("TicketLastActivityBy")
  ticketReads        TicketRead[]
  pushSubscriptions  PushSubscription[]
}

/// A browser or phone that turned on device notifications (Web Push). One row per device; gone when it's turned off
/// or the push service says the address no longer exists.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  /// A short label such as "Chrome on Windows", so people can tell their devices apart.
  device     String
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

model Session {
  id        String   @id // SHA-256 of the cookie token; the raw token is never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// The ERP's real module → sub-module tree used by tickets and the team directory.
model ErpArea {
  id        String       @id @default(cuid())
  parentId  String?
  parent    ErpArea?     @relation("AreaTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  ErpArea[]    @relation("AreaTree")
  name      String
  code      String?      @unique
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   AreaMember[]
  tickets   Ticket[]

  @@unique([parentId, name])
}

model AreaMember {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId     String
  area       ErpArea  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  isLead     Boolean  @default(false)
  /// Works on this module as its UI/UX designer, listed under UI/UX. Only for people with the Designer tick-box.
  asDesigner Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@id([userId, areaId])
  @@index([areaId])
}

// ── QA Hub: tickets (Phase 3.5b) ──
// Ticket text and attachments show customer data, so they never go to an LLM (CLAUDE.md rule 1).

enum TicketType {
  BUG
  SUGGESTION
  IMPROVEMENT
}

enum TicketCategory {
  FRONT_END
  BACK_END
  UI_UX
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  NEED_INFO
  FIXED
  VERIFIED
  CLOSED
  REOPENED
  REJECTED
  DUPLICATE
  WONT_FIX
}

enum AttachmentKind {
  IMAGE
  VIDEO
}

model Ticket {
  id               String          @id @default(cuid())
  number           Int             @unique // shown as #12; max + 1 when created
  type             TicketType
  title            String
  description      String
  status           TicketStatus    @default(NEW)
  severity         Severity? // bugs only
  priority         Priority        @default(P3)
  foundIn          String? // ERP build or environment, free text
  deviceType       String? // bugs only: DEVICE_TYPES in lib/tickets/workflow.ts
  category         TicketCategory? // required on new tickets (lib/schemas/ticket.ts); empty on older ones until tagged
  areaId           String?
  area             ErpArea?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  reporterId       String
  reporter         User            @relation("TicketReporter", fields: [reporterId], references: [id])
  assigneeId       String?
  assignee         User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  duplicateOfId    String?
  duplicateOf      Ticket?         @relation("TicketDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates       Ticket[]        @relation("TicketDuplicate")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lastActivityAt   DateTime        @default(now())
  /// Who caused lastActivityAt. Everyone else who can see the ticket gets it as unread (lib/tickets/notifications.ts).
  lastActivityById String?
  lastActivityBy   User?           @relation("TicketLastActivityBy", fields: [lastActivityById], references: [id], onDelete: SetNull)
  closedAt         DateTime?
  comments         TicketComment[]
  events           TicketEvent[]
  attachments      Attachment[]
  reads            TicketRead[]

  @@index([status, lastActivityAt])
  @@index([assigneeId, status])
  @@index([areaId])
  @@index([reporterId])
}

/// When a person last opened a ticket. A ticket with newer activity by someone else is unread for them.
model TicketRead {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  readAt   DateTime

  @@id([userId, ticketId])
  @@index([ticketId])
}

model TicketComment {
  id          String       @id @default(cuid())
  ticketId    String
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime     @default(now())
  attachments Attachment[]

  @@index([ticketId, createdAt])
}

/// The timeline. `kind` is CREATED | STATUS | ASSIGNEE | FIELD; `from`/`to` hold the old and new values.
model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  kind      String
  field     String?
  from      String?
  to        String?
  note      String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// The file lives in the private Storage bucket under `storedName` (generated). `originalName` is for display only.
model Attachment {
  id           String         @id @default(cuid())
  ticketId     String
  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploaderId   String
  uploader     User           @relation(fields: [uploaderId], references: [id])
  kind         AttachmentKind
  storedName   String         @unique
  originalName String
  mime         String
  size         Int
  durationSec  Int? // videos, when the file says how long it is
  createdAt    DateTime       @default(now())

  @@index([ticketId])
}

enum UploadStatus {
  SIGNED // the browser has a signed URL and may be uploading
  READY // the file arrived and its real type, size and length were checked
}

/// An image or video uploaded straight to Storage before its ticket or reply is sent. The form claims READY ones by id;
/// unclaimed ones are swept after a day.
model PendingUpload {
  id           String         @id @default(cuid())
  uploaderId   String
  uploader     User           @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  kind         AttachmentKind
  status       UploadStatus   @default(SIGNED)
  storedName   String         @unique
  originalName String
  mime         String
  size         Int
  durationSec  Int?
  createdAt    DateTime       @default(now())

  @@index([uploaderId])
  @@index([createdAt])
}

// ── QA Hub: Daily Accomplishment Report (DAR) ──

/// A person's own DAR set-up (My DAR → My details): everything fixed on their report. There is no shared template;
/// empty fields stay empty on the report.
model DarProfile {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String? // the formal name on the report; accounts only hold a nickname
  position         String?
  department       String?
  unit             String?
  confirmedByName  String? // the immediate supervisor
  confirmedByTitle String?
  notedByName      String?
  notedByTitle     String?
  coreFunctions    Json? // [{ duty, mfo, autofill }]
  supportFunctions Json?
  firstPeriodStart String? // "2026-11-01", where their list of periods starts
  periodScheme     String? // "1-16" (default) or "3-18": the days their periods start on (lib/dar/period.ts)
  updatedAt        DateTime @updatedAt
}

/// One person's DAR for one half-month period. Only what they typed is stored; the header comes from their
/// DarProfile when the file is made.
model DarReport {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart   String // "2026-10-16", a date in Manila
  periodEnd     String
  cells         Json // { core: string[][], support: string[][] }, one string per day per function row
  dateSubmitted String? // "2026-10-31"
  days          Json? // { "2026-11-03": { status, in?, out?, where? } }: Present, Rest day, Leave… (lib/dar/attendance.ts)
  autoCells     Json? // what QA Hub last wrote in each cell from ticket work, so a refill replaces it instead of adding it twice
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, periodStart])
}
